<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title).presence || "Dummy host" %></title>
  </head>
  <body>
    <nav>
      <a href="<%= host_home_path %>" id="host-home-link">Host home</a>
      <%# How a host marks its Peerwatch nav item active. %>
      <a href="<%= peerwatch.dashboard_path %>" id="host-peerwatch-link"
         class="<%= "active" if controller_path.start_with?("peerwatch/") %>">Peerwatch</a>
    </nav>
    <ol id="host-breadcrumbs"><%= yield :breadcrumbs %></ol>
    <%= yield %>
  </body>
</html>
