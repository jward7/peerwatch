<%= peerwatch_page :dashboard %>
<div class="peerwatch peerwatch-dashboard">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Peerwatch</h1>
    <%= link_to "Manage peers", peerwatch.mesh_peers_path, class: "btn btn-outline-primary btn-sm" %>
  </div>

  <% if @self_name.blank? %>
    <div class="alert alert-warning">This app has no <code>self_name</code> configured, so it probes nothing.</div>
  <% end %>

  <%= render "matrix" %>

  <h2 class="h5">Open incidents</h2>
  <%= render "incidents", incidents: @open_incidents, empty: "None." %>

  <h2 class="h5">Recently resolved</h2>
  <%= render "incidents", incidents: @resolved_incidents, empty: "None yet." %>
</div>
